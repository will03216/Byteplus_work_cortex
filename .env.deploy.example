# Copy this to .env.deploy and fill in your values.
# Used by deploy.sh and Makefile. Never commit .env.deploy to git.

# ── ECS target ────────────────────────────────────────────────────────────────
ECS_IP=your.ecs.elastic.ip           # Elastic IP of your ECS instance

# ── Byteplus Container Registry ───────────────────────────────────────────────
# Format: [Instance]-[Region].cr.volces.com
# Find your exact URL in Byteplus Console → CR → your repo → Push Command
CR_REGISTRY=cr-mittul-ap-southeast-3.cr.bytepluses.com
CR_NAMESPACE=mittul
CR_REPO=lead-engine
CR_USERNAME=mittul.madaan@78638713        # format: username@user-id
CR_PASSWORD=your-cr-password              # the password set in CR access credentials

# ── App location on server ────────────────────────────────────────────────────
APP_DIR=/opt/lead-engine
