#
# Copy this file to `.env` and fill in the provider you want to use.
#

# Common config
LLM_MODEL=anthropic/claude-haiku-4-5-20251001
LLM_API_KEY=your-provider-api-key
LLM_PROVIDER=
LLM_API_BASE=
LLM_TIMEOUT_SECONDS=30

# Example: Anthropic via LiteLLM
# LLM_MODEL=anthropic/claude-haiku-4-5-20251001
# LLM_API_KEY=sk-ant-...
# LLM_PROVIDER=
# LLM_API_BASE=

# Example: BytePlus ModelArk / Dola Seed 2.0 Pro
# Uses the OpenAI-compatible chat completions API shape exposed by ModelArk.
# LLM_MODEL=seed-2-0-pro-260328
# LLM_API_KEY=your-ark-api-key
# LLM_PROVIDER=openai
# LLM_API_BASE=https://ark.ap-southeast.bytepluses.com/api/v3
