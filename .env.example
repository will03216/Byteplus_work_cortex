#
# Copy this file to `.env` and fill in the provider you want to use.
#

# Common config
LLM_MODEL=anthropic/claude-haiku-4-5-20251001
LLM_API_KEY=your-provider-api-key
LLM_PROVIDER=
LLM_API_BASE=
LLM_TIMEOUT_SECONDS=30

# Example: Anthropic via LiteLLM
# LLM_MODEL=anthropic/claude-haiku-4-5-20251001
# LLM_API_KEY=sk-ant-...
# LLM_PROVIDER=
# LLM_API_BASE=

# Example: BytePlus ModelArk / Dola Seed 2.0 Pro
# Uses the OpenAI-compatible chat completions API shape exposed by ModelArk.
# LLM_MODEL=seed-2-0-pro-260328
# LLM_API_KEY=your-ark-api-key
# LLM_PROVIDER=openai
# LLM_API_BASE=https://ark.ap-southeast.bytepluses.com/api/v3

# Apollo.io — company enrichment (disabled by default; set APOLLO_ENABLED=true to activate)
APOLLO_ENABLED=false
APOLLO_API_KEY=your-apollo-api-key
APOLLO_TIMEOUT_SECONDS=10
APOLLO_SSL_VERIFY=true

# Auth — protect the web UI with a username and password
APP_USERNAME=admin
APP_PASSWORD=change-me
SESSION_SECRET=replace-with-a-long-random-string

# Instantly — email outreach integration
INSTANTLY_API_KEY=your-instantly-api-key
# Fallback/default campaign. With multi-campaign routing (Settings → Routing),
# leads are sent to the campaign mapped to their vertical; anything unmapped
# falls back to this default.
INSTANTLY_CAMPAIGN_ID=your-campaign-id
INSTANTLY_SCORE_THRESHOLD=75
PLACEHOLDER_EMAIL=mittulmadaan91@gmail.com
